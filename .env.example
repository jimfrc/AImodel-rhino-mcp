# 复制成 .env 后填写。.env 不会入库（见 .gitignore）。
# 优先级：真实环境变量 > golem-mcp/.env > 隔壁 rhino-mcp-agent/.env > 代码默认值

# ---------- LLM ----------
# DeepSeek API Key，必填
DEEPSEEK_API_KEY=
# OpenAI 兼容端点
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 模型名。89 个工具建议用 deepseek-v4-pro，flash 容易漏调用工具
RHINO_WEB_MODEL=deepseek-v4-pro
RHINO_WEB_TEMPERATURE=0.2
RHINO_WEB_MAX_TOKENS=8192
RHINO_WEB_LLM_TIMEOUT=300

# ---------- 闭环控制 ----------
# 单轮最多工具回合
RHINO_WEB_MAX_TURNS=25
# 是否把截图喂给模型（0 = 只在本页展示，不消耗 token）
RHINO_WEB_VISION=1
# 历史中保留的最近截图张数
RHINO_WEB_KEEP_IMAGES=1
# 上传给模型前把截图最长边缩到多少像素
RHINO_WEB_IMAGE_MAX_SIDE=1024
# 单次工具调用超时（秒）
RHINO_WEB_RPC_TIMEOUT=180
# 工具黑名单，逗号分隔。例：execute_python,run_rhino_command,execute_rhinoscript
RHINO_WEB_DENY_TOOLS=

# ---------- 网页服务 ----------
RHINO_WEB_HOST=127.0.0.1
RHINO_WEB_PORT=8849

# ---------- GOLEM 插件桥（两侧必须一致）----------
GOLEM_RHINO_HOST=127.0.0.1
GOLEM_RHINO_PORT=9876
